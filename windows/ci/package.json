{
  "schemaVersion": 1,
  "distribution": "dll-sql",
  "sqlInstallPath": ["1.10", "1.11", "1.12", "1.13", "1.14", "1.15", "1.16", "{version}"],
  "files": [
    {
      "source": "upstream",
      "path": "pg_ivm.dll",
      "destination": "lib/pg_ivm.dll",
      "targets": ["install", "zip"]
    },
    {
      "source": "upstream",
      "path": "pg_ivm.control",
      "destination": "share/extension/pg_ivm.control",
      "targets": ["install", "zip"]
    },
    {
      "source": "upstream",
      "path": "pg_ivm--*.sql",
      "destination": "share/extension/{fileName}",
      "targets": ["install", "zip"],
      "expectedCount": 19
    },
    {
      "source": "license",
      "path": "LICENSE",
      "destination": "LICENSE",
      "targets": ["zip"]
    },
    {
      "source": "upstream",
      "path": "README.md",
      "destination": "UPSTREAM-README.md",
      "targets": ["zip"]
    },
    {
      "source": "upstream",
      "path": "scripts/pg_ivm_dump_metadata",
      "destination": "upstream-scripts/pg_ivm_dump_metadata",
      "targets": ["zip"],
      "optional": true
    }
  ],
  "packageInfo": [
    "pg_ivm Windows binary package",
    "=============================",
    "",
    "Upstream repository: {upstreamRepository}",
    "Upstream ref:        {upstreamRef}",
    "Upstream commit:     {upstreamCommit}",
    "pg_ivm version:      {version}",
    "PostgreSQL major:    {pgMajor}",
    "PostgreSQL tested:   {pgTested}",
    "Architecture:        {architecture}",
    "Compiler:            MSVC",
    "License:             PostgreSQL-style; see LICENSE",
    "",
    "This is an unofficial pgextwin Windows package built from the official pg_ivm source.",
    "For correct immediate view maintenance, preload pg_ivm using shared_preload_libraries",
    "or session_preload_libraries as documented by upstream."
  ]
}
